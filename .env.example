# ---------------------------------------------------------------------------
# AgroData Engine — variáveis compartilhadas (raiz do repositório)
# Copie para `.env` apenas para uso local. Em produção use os secrets do
# GitHub Actions (dados) e as env vars do Render (API).
# ---------------------------------------------------------------------------

# --- PostgreSQL (docker-compose / Supabase) --------------------------------
POSTGRES_USER=admin
POSTGRES_PASSWORD=mysecretpassword
POSTGRES_DB=agro_data_engine

# --- API .NET --------------------------------------------------------------
# Usada pelo AddInfrastructure (env var sobrepõe appsettings).
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=agro_data_engine;Username=admin;Password=mysecretpassword
# Origem liberada no CORS. Uma entrada por variável, a partir do índice 0.
# Cors__AllowedOrigins__0=http://localhost:5173
FRONTEND_URL=http://localhost:5173
ASPNETCORE_ENVIRONMENT=Development

# --- Data engine (Python) --------------------------------------------------
DATABASE_URL=postgresql://admin:mysecretpassword@localhost:5432/agro_data_engine
DATA_SOURCE=simulated
SYMBOLS=SOJA,MILHO
LOG_LEVEL=INFO
