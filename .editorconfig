root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csproj,props,slnx}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.py]
indent_size = 4
max_line_length = 100

[{*.yml,*.yaml,*.json}]
indent_size = 2

[*.{cs}]
# Keep the C# style guide from the .NET team.
csharp_new_line_before_open_brace = all
csharp_style_namespace_declarations = file_scoped:suggestion
dotnet_sort_system_directives_first = true
dotnet_diagnostic.CA1848.severity = suggestion

# EF Core migrations are generated/edited by tooling: keep analyzers quiet.
[src/backend/AgroData.Infrastructure/Migrations/*.cs]
generated_code = true
dotnet_diagnostic.CA1861.severity = none
