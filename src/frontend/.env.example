# Base URL of the .NET API.
# Leave empty to use relative URLs (the Vite dev server proxies /api to the API).
VITE_API_URL=

# Public path the app is served from. GitHub Pages uses the repository name.
VITE_BASE=/AgroData_Engine/

# Only used by the dev server proxy.
VITE_PROXY_TARGET=http://localhost:5072

# Extra hosts allowed to reach the dev server (tunnels, cloud previews).
# VITE_ALLOWED_HOSTS=.e2b.app,.ngrok-free.app
