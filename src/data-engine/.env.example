# --- AgroData Engine -------------------------------------------------------
# Copy to .env for local runs. Real values live in GitHub Actions secrets.

# Warehouse (PostgreSQL / Supabase)
DATABASE_URL=postgresql://admin:mysecretpassword@localhost:5432/agrodata

# Data source: "simulated" (default, deterministic) or "http"
DATA_SOURCE=simulated
# COMMODITY_API_URL=https://api.example.com/v1/commodities
# SOURCE_LABEL=Market Provider

# Which symbols to ingest (comma separated)
SYMBOLS=SOJA,MILHO

# Observability
LOG_LEVEL=INFO
LOG_JSON=false
